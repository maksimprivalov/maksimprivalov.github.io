---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../config';
import { url } from '../lib/url';
---

<BaseLayout title={`Page not found | ${SITE.name}`} description="This page does not exist." noindex>
  <Container size="prose" class="py-28 md:py-36">
    <p class="eyebrow">
      <span class="text-accent">404</span> / Not found
    </p>
    <h1 class="text-h1 mt-4">This page doesn't exist</h1>
    <p class="text-lead mt-4">It may have moved, or the link is wrong.</p>
    <p class="mt-6 font-mono text-sm text-muted tabular">
      Σ requested − Σ found = 1 page <span class="text-danger">✗</span>
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href={url()} iconEnd="arrow-right">
        Back to home
      </Button>
      <Button href={url('#projects')} variant="secondary">
        See projects
      </Button>
    </div>
  </Container>
</BaseLayout>
