---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center px-6 py-24">
    <p class="mb-8 inline-flex items-center gap-2 text-sm text-muted">
      <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
      {SITE.status}
    </p>
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{SITE.name}</h1>
    <p class="mt-3 font-mono text-sm text-muted">Backend Engineer · FinTech</p>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-text/90">
      I build payment systems, ledgers and distributed backends in Java/Kotlin, Spring Boot, Rust
      and Go.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={SITE.github}
        class="rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
      >
        GitHub
      </a>
      <a
        href={`mailto:${SITE.email}`}
        class="rounded-lg border border-line px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
      >
        Email me
      </a>
    </div>
    <p class="mt-16 font-mono text-xs text-muted">Site under construction.</p>
  </main>
</BaseLayout>
