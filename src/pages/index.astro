---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import Icon from '../components/ui/Icon.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import BinaryCoin from '../components/BinaryCoin.astro';
import { SITE } from '../config';
import { url } from '../lib/url';
import { cv } from '../data/cv';
import { moreProjects } from '../data/more-projects';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const more = [
  ...projects
    .filter((p) => !p.data.featured)
    .map((p) => ({
      name: p.data.title,
      stack: p.data.tech.slice(0, 3).join(', '),
      summary: p.data.summary,
      href: url(`projects/${p.id}`),
    })),
  ...moreProjects,
];

// Figures from cv/main.tex.
const stats = [
  { value: '~86%', label: 'less server RAM after a multi-tenant redesign' },
  { value: '50,000+', label: 'users on the platform I build for' },
  { value: 'Σ = 0', label: 'double-entry ledger behind my payment saga' },
];

// Key facts next to the bio, from cv/main.tex.
const about = [
  { label: 'Based in', value: cv.location },
  { label: 'Focus', value: 'Payments, ledgers, distributed systems' },
  { label: 'Core stack', value: 'Java, Kotlin, Spring Boot, Rust' },
  { label: 'Education', value: 'BSc Software Engineering (GPA 9/10), now MSc at FTN Novi Sad' },
  { label: 'Languages', value: cv.languages.join(', ') },
];
---

<BaseLayout>
  <!-- Hero -->
  <section id="hero" aria-labelledby="hero-title" class="relative overflow-hidden">
    <Container class="relative pt-16 pb-20 md:pt-24 md:pb-28">
      <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:gap-12">
        <div>
          <StatusBadge class="lg:hidden" data-reveal />
          <h1 id="hero-title" class="text-display mt-8 lg:mt-0" data-reveal>
            {SITE.name}
          </h1>
          <p
            class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-sm text-muted"
            data-reveal
            style="--reveal-delay: 60ms"
          >
            <span class="whitespace-nowrap">Backend Engineer, FinTech</span>
            <span class="border-l border-line pl-5 whitespace-nowrap">{cv.location}</span>
          </p>
          <p class="text-lead mt-6 max-w-xl" data-reveal style="--reveal-delay: 120ms">
            {cv.tagline} I work mostly in Java and Spring Boot, and build payment infrastructure in
            Rust.
          </p>
          <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 180ms">
            <Button href="#projects" iconEnd="arrow-right">
              See my projects
            </Button>
            <Button href={`mailto:${SITE.email}`} variant="secondary" icon="mail">
              Email me
            </Button>
          </div>
        </div>

        <div
          class="relative mx-auto w-full max-w-[18rem] sm:max-w-[22rem] lg:max-w-none"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          <!-- The page's single glow sits behind the coin. -->
          <div
            class="glow top-1/2 left-1/2 w-[140%]! -translate-x-1/2 -translate-y-1/2"
            aria-hidden="true"
          ></div>
          <BinaryCoin />
        </div>
      </div>

      <dl
        class="mt-16 grid divide-y divide-line rounded-lg border border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0"
        data-reveal
        style="--reveal-delay: 240ms"
      >
        {stats.map((s) => (
          <div class="flex flex-col-reverse gap-1.5 p-5">
            <dt class="text-sm text-muted">{s.label}</dt>
            <dd class="tabular font-mono text-2xl font-medium tracking-tight">{s.value}</dd>
          </div>
        ))}
      </dl>
    </Container>
  </section>

  <!-- About -->
  <section id="about" aria-labelledby="about-title" class="border-t border-line">
    <Container class="py-20 md:py-28">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] lg:gap-16">
        <div data-reveal>
          <SectionHeading index="01" label="About" title="A short bio" id="about-title" />
          <div class="mt-8 max-w-2xl space-y-5 text-[1.0625rem] leading-relaxed text-text/90">
            <p>
              I'm a backend engineer in Novi Sad, Serbia, and I work on FinTech systems: payments,
              ledgers and the services around them. Most of my production work is in Java and Spring
              Boot; my payment side projects are in Rust.
            </p>
            <p>
              At the Faculty of Technical Sciences in Novi Sad I build a platform used by 50,000+
              people. I redesigned it as a multi-tenant system, which cut server RAM by about 86%,
              and moved a Windows-only document-signing system to macOS and Linux with Java PKCS#11.
              Before that, at Digital Access Logic, I integrated payments through a bank API broker
              and automated fiscal receipts.
            </p>
            <p>
              The problems I like most are the ones where money must never be lost or counted twice:
              sagas, idempotency and double-entry ledgers. My
              <a href={url('projects/payment-processing-service')} class="link">
                Payment Processing Service
              </a>{' '}
              is built around exactly that.
            </p>
          </div>
        </div>

        <dl
          class="h-fit divide-y divide-line self-start rounded-lg border border-line text-sm lg:mt-2"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          {about.map((f) => (
            <div class="grid gap-1 p-4">
              <dt class="eyebrow">{f.label}</dt>
              <dd class="text-text/90">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Container>
  </section>

  <!-- Projects -->
  <section id="projects" aria-labelledby="projects-title" class="border-t border-line">
    <Container class="py-20 md:py-28">
      <div data-reveal>
        <SectionHeading index="02" label="Projects" title="Selected work" id="projects-title">
          Payments, risk and data systems, each with a write-up of the architecture and the
          decisions behind it.
        </SectionHeading>
      </div>

      <ul class="mt-12 grid gap-4 md:grid-cols-2">
        {featured.map((p, i) => (
          <li class="flex" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
            <Card
              class="w-full"
              href={url(`projects/${p.id}`)}
              meta={p.data.kind}
              title={p.data.title}
              description={p.data.summary}
              tags={p.data.tech.slice(0, 4)}
            />
          </li>
        ))}
      </ul>

      <div class="mt-16" data-reveal>
        <h3 class="eyebrow">More projects</h3>
        <ul class="mt-4 border-t border-line">
          {more.map((p) => (
            <li class="border-b border-line">
              {p.href ? (
                <a
                  href={p.href}
                  class="group grid gap-1 py-5 sm:grid-cols-[1fr_auto] sm:gap-x-8"
                  {...(p.href.startsWith('http') && {
                    target: '_blank',
                    rel: 'noopener noreferrer',
                  })}
                >
                  <span class="flex items-center gap-2 font-medium transition-colors duration-150 group-hover:text-accent">
                    {p.name}
                    <Icon
                      name="arrow-up-right"
                      size={14}
                      class="text-muted transition-colors duration-150 group-hover:text-accent"
                    />
                  </span>
                  <span class="font-mono text-xs text-muted sm:row-span-2 sm:pt-1.5 sm:text-right">
                    {p.stack}
                  </span>
                  <span class="text-sm text-muted">{p.summary}</span>
                </a>
              ) : (
                <div class="grid gap-1 py-5 sm:grid-cols-[1fr_auto] sm:gap-x-8">
                  <span class="font-medium">{p.name}</span>
                  <span class="font-mono text-xs text-muted sm:row-span-2 sm:pt-1.5 sm:text-right">
                    {p.stack}
                  </span>
                  <span class="text-sm text-muted">{p.summary}</span>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </section>

  <!-- Experience -->
  <section id="experience" aria-labelledby="experience-title" class="border-t border-line">
    <Container class="py-20 md:py-28">
      <div data-reveal>
        <SectionHeading
          index="03"
          label="Experience"
          title="Where I've worked"
          id="experience-title"
        />
      </div>

      <ol class="mt-12">
        {cv.experience.map((job) => (
          <li
            class="grid gap-3 border-t border-line py-8 md:grid-cols-[12rem_1fr] md:gap-10"
            data-reveal
          >
            <p class="tabular font-mono text-sm text-muted md:pt-0.5">{job.dates}</p>
            <div>
              <h3 class="text-h3">{job.role}</h3>
              <p class="mt-1 text-[0.9375rem] text-text/90">{job.org}</p>
              <p class="mt-0.5 text-sm text-muted">{job.location}</p>
              <ul class="mt-4 space-y-2.5 text-[0.9375rem] leading-relaxed text-text/90">
                {job.highlights.map((h) => (
                  <li class="relative pl-5">
                    <span
                      class="absolute top-[0.7em] left-0 size-1.5 rounded-full bg-accent/70"
                      aria-hidden="true"
                    />
                    {h}
                  </li>
                ))}
              </ul>
              {job.tech && (
                <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
                  {job.tech.map((t) => (
                    <li>
                      <Tag>{t}</Tag>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-4 border-t border-line pt-8" data-reveal>
        <Button href={url('cv')} variant="secondary" icon="file-text">
          Full CV
        </Button>
      </div>
    </Container>
  </section>

  <!-- Writing -->
  <section id="writing" aria-labelledby="writing-title" class="border-t border-line">
    <Container class="py-20 md:py-28">
      <div data-reveal>
        <SectionHeading
          index="04"
          label="Writing"
          title="Notes on payments engineering"
          id="writing-title"
        >
          First posts are on the way: idempotency, sagas and ledger design.
        </SectionHeading>
      </div>
    </Container>
  </section>

  <!-- Contact -->
  <section id="contact" aria-labelledby="contact-title" class="border-t border-line">
    <Container class="py-20 md:py-28">
      <div data-reveal>
        <SectionHeading index="05" label="Contact" title="Let's talk" id="contact-title">
          I'm open to backend and FinTech roles. Email is the fastest way to reach me.
        </SectionHeading>
        <p class="mt-8 font-mono text-sm">
          <a href={`mailto:${SITE.email}`} class="link">
            {SITE.email}
          </a>
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={`mailto:${SITE.email}`} icon="mail">
            Email me
          </Button>
          <Button href={SITE.linkedin} variant="secondary" icon="linkedin">
            LinkedIn
          </Button>
          <Button href={SITE.github} variant="secondary" icon="github">
            GitHub
          </Button>
          <Button href={url('cv')} variant="ghost" icon="file-text">
            CV
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
