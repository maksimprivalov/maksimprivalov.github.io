---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';
import { SITE } from '../config';
import { url } from '../lib/url';
import { cv } from '../data/cv';

const sectionTitle = 'text-[1.375rem] font-semibold tracking-[-0.02em]';
const sectionClass = 'mt-16 border-t border-line pt-10';
---

<BaseLayout
  title={`CV | ${SITE.name}`}
  description={`CV of ${cv.name}: ${cv.tagline} Experience, projects, skills and education.`}
>
  <Container size="prose" class="pt-16 md:pt-24">
    <header>
      <p class="eyebrow">Curriculum vitae</p>
      <h1 class="text-h1 mt-4">{cv.name}</h1>
      <p class="mt-3 font-mono text-sm text-muted">
        {cv.headline} · {cv.location}
      </p>
      <p class="text-lead mt-5">{cv.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={url('cv.pdf')} icon="download" download="Maksim-Privalov-CV.pdf">
          Download PDF
        </Button>
        <Button href={`mailto:${SITE.email}`} variant="secondary" icon="mail">
          {SITE.email}
        </Button>
      </div>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <li>
          <a href={SITE.github} class="link" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        </li>
        <li>
          <a href={SITE.linkedin} class="link" target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        </li>
      </ul>
    </header>

    <section aria-labelledby="cv-experience" class={sectionClass}>
      <h2 id="cv-experience" class={sectionTitle}>
        Professional experience
      </h2>
      <ol class="mt-8 space-y-10">
        {cv.experience.map((job) => (
          <li>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="font-semibold">{job.org}</h3>
              <p class="tabular shrink-0 font-mono text-sm text-muted">{job.dates}</p>
            </div>
            <p class="mt-1 text-sm text-muted">
              {job.role} · {job.location}
            </p>
            <ul class="mt-4 space-y-2.5 text-[0.9375rem] leading-relaxed text-text/90">
              {job.highlights.map((h) => (
                <li class="relative pl-5">
                  <span
                    class="absolute top-[0.7em] left-0 size-1.5 rounded-full bg-accent/70"
                    aria-hidden="true"
                  />
                  {h}
                </li>
              ))}
            </ul>
            {job.tech && (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
                {job.tech.map((t) => (
                  <li>
                    <Tag>{t}</Tag>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="cv-projects" class={sectionClass}>
      <h2 id="cv-projects" class={sectionTitle}>
        Projects
      </h2>
      <ul class="mt-8 space-y-6">
        {cv.projects.map((p) => (
          <li>
            <h3 class="font-semibold">
              {p.slug ? (
                <a href={url(`projects/${p.slug}`)} class="link">
                  {p.name}
                </a>
              ) : (
                p.name
              )}
            </h3>
            <p class="mt-1 font-mono text-xs text-muted">{p.stack.join(' · ')}</p>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-text/90">{p.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="cv-skills" class={sectionClass}>
      <h2 id="cv-skills" class={sectionTitle}>
        Skills
      </h2>
      <dl class="mt-8 divide-y divide-line">
        {cv.skills.map((s) => (
          <div class="grid gap-1 py-3.5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="text-sm text-muted">{s.group}</dt>
            <dd class="text-[0.9375rem]">
              {s.items.join(', ')}
              {s.familiar && <span class="text-muted"> · familiar: {s.familiar.join(', ')}</span>}
              {s.tools && <span class="text-muted"> · tools: {s.tools.join(', ')}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="cv-education" class={sectionClass}>
      <h2 id="cv-education" class={sectionTitle}>
        Education
      </h2>
      <ol class="mt-8 space-y-8">
        {cv.education.map((e) => (
          <li>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="font-semibold">{e.school}</h3>
              <p class="tabular shrink-0 font-mono text-sm text-muted">{e.dates}</p>
            </div>
            <p class="mt-1 text-[0.9375rem] text-text/90">{e.degree}</p>
            <p class="mt-1 text-sm text-muted">{e.location}</p>
            {e.notes?.map((n) => (
              <p class="mt-2 text-sm text-muted">{n}</p>
            ))}
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="cv-more" class={sectionClass}>
      <h2 id="cv-more" class={sectionTitle}>
        Achievements and languages
      </h2>
      <ul class="mt-8 space-y-2.5 text-[0.9375rem] text-text/90">
        {cv.achievements.map((a) => (
          <li class="relative pl-5">
            <span
              class="absolute top-[0.7em] left-0 size-1.5 rounded-full bg-accent/70"
              aria-hidden="true"
            />
            {a}
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-muted">Languages: {cv.languages.join(' · ')}</p>
    </section>
  </Container>
</BaseLayout>
