---
import Icon from './Icon.astro';
import Tag from './Tag.astro';

interface Props {
  title: string;
  href?: string;
  /** Small mono line above the title (e.g. stack, date, "Featured"). */
  meta?: string;
  description?: string;
  tags?: readonly string[];
  /** Heading level for the title, to keep the page outline correct. */
  as?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  title,
  href,
  meta,
  description,
  tags = [],
  as: Heading = 'h3',
  class: className,
} = Astro.props;
const Root = href ? 'a' : 'article';
const external = href !== undefined && /^https?:\/\//.test(href);
---

<Root
  href={href}
  class:list={['card', className]}
  {...(external && { target: '_blank', rel: 'noopener noreferrer' })}
>
  {(meta || href) && (
    <div class="flex items-start justify-between gap-4">
      {meta && <p class="font-mono text-xs text-muted">{meta}</p>}
      {href && <Icon name="arrow-up-right" size={18} class="card-arrow ml-auto shrink-0" />}
    </div>
  )}
  <Heading class="card-title text-h3">{title}</Heading>
  {description && <p class="text-sm leading-relaxed text-muted">{description}</p>}
  <slot />
  {tags.length > 0 && (
    <ul class="mt-auto flex flex-wrap gap-2 pt-2" aria-label="Technologies">
      {tags.map((t) => (
        <li>
          <Tag>{t}</Tag>
        </li>
      ))}
    </ul>
  )}
</Root>
