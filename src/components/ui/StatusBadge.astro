---
import type { HTMLAttributes } from 'astro/types';
import { SITE } from '../../config';
import { url } from '../../lib/url';

type Props = HTMLAttributes<'a'>;

const { class: className, ...rest } = Astro.props;
---

<!-- Links to the contact section, from every page. -->
<a
  href={url('#contact')}
  class:list={[
    'group inline-flex items-center gap-2.5 rounded-md text-sm text-muted transition-colors duration-150 hover:text-text',
    className,
  ]}
  {...rest}
>
  <span class="relative flex size-2" aria-hidden="true">
    <span class="absolute inline-flex size-full rounded-full bg-accent motion-safe:animate-[status-ping_2.4s_var(--ease-out)_infinite]"></span>
    <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
  </span>
  <span class="underline decoration-transparent decoration-1 underline-offset-4 transition-colors duration-150 group-hover:decoration-accent">
    {SITE.status}
  </span>
</a>
